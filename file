{% extends "base.html" %}

{% block content %}
    <h1>Личный кабинет</h1>

    <div class="grid">
        <div class="card">
            <h2>Новая заявка</h2>
            <form method="post">
                {% csrf_token %}
                {{ form.as_p }}
                <button type="submit" style="width: 100%; margin-top: 10px;">Отправить</button>
            </form>
        </div>

        <div>
            <h2>{% if user.is_staff %}Все заявки (Админ){% else %}Мои заявки{% endif %}</h2>
            {% for app in applications %}
                <div class="card">
                    <h3>{{ app.transport.name }}</h3>
                    <p><strong>Дата:</strong> {{ app.start_date }}</p>
                    <p><strong>Оплата:</strong> {{ app.payment_method }}</p>
                    <p><strong>Статус:</strong> <span style="color: var(--blue); font-weight: bold;">{{ app.get_status_display }}</span></p>
                    
                    {% if user.is_staff %}
                        <a href="/admin/app/application/{{ app.id }}/change/" class="btn" style="display: inline-block; margin-top: 10px; font-size: 14px; padding: 8px 12px;">Изменить в админке</a>
                    {% endif %}
                </div>
            {% empty %}
                <div class="card">
                    <p>У вас пока нет заявок. Создайте первую!</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}






{% extends "base.html" %}
{% load static %}

{% block content %}
    <h1>Наш транспорт</h1>
    <div class="grid">
        {% for t in transports %}
            <div class="card">
                {% if t.image %}
                    <img src="{{ t.image.url }}" alt="{{ t.name }}" style="width: 100%; height: 200px; object-fit: cover; border-radius: 5px; margin-bottom: 10px;">
                {% else %}
                    <img src="{% static 'images/image (2).jpeg' %}" alt="Транспорт" style="width: 100%; height: 200px; object-fit: cover; border-radius: 5px; margin-bottom: 10px;">
                {% endif %}
                
                <h3>{{ t.name }}</h3>
                <p style="color: var(--gray);">{{ t.get_transport_type_display }}</p>
                <a href="{% url 'cabinet' %}" class="btn" style="display: block; text-align: center; margin-top: 10px;">Забронировать</a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
