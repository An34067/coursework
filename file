{% extends "base.html" %}
{% load static %}

{% block content %}
    <h1>Аренда речного транспорта</h1>
    <p style="margin-bottom: 20px;">Катера, круизные лайнеры и яхты для вашего отдыха.</p>

    <div class="slider-container">
        <img src="{% static 'images/image (1).jpeg' %}" class="slide active" alt="Катер">
        <img src="{% static 'images/image (2).jpeg' %}" class="slide" alt="Лайнер">
        <img src="{% static 'images/image (3).jpeg' %}" class="slide" alt="Яхта">
        <img src="{% static 'images/image.jpeg' %}" class="slide" alt="Транспорт">
    </div>

    <h2>Почему выбирают нас?</h2>
    <div class="grid">
        <div class="card">
            <h3>Безопасность</h3>
            <p>Все суда проходят регулярный техосмотр.</p>
        </div>
        <div class="card">
            <h3>Опытные капитаны</h3>
            <p>Наши капитаны имеют стаж более 10 лет.</p>
        </div>
        <div class="card">
            <h3>Удобная оплата</h3>
            <p>Оплата картой или наличными при посадке.</p>
        </div>
    </div>

    <script>
        let slides = document.querySelectorAll('.slide');
        let currentSlide = 0;
        function nextSlide() {
            slides[currentSlide].classList.remove('active');
            currentSlide = (currentSlide + 1) % slides.length;
            slides[currentSlide].classList.add('active');
        }
        setInterval(nextSlide, 3000);
    </script>
{% endblock %}





