from django.db import models
from django.contrib.auth.models import User  # <--- Берем стандартного юзера
from django.core.validators import MinValueValidator


class Course(models.Model):
    title = models.CharField("Название", max_length=255)
    image = models.ImageField("Изображение", upload_to='courses/', blank=True, null=True)
    price = models.DecimalField(
        "Цена", max_digits=10, decimal_places=2,
        validators=[MinValueValidator(0)]
    )
    duration = models.CharField("Длительность", max_length=50)

    def __str__(self):
        return self.title


class Request(models.Model):
    user = models.ForeignKey(User, on_delete=models.CASCADE)
    course = models.ForeignKey(Course, on_delete=models.CASCADE)
    status = models.CharField(
        choices=[('new', 'Новая'), ('confirmed', 'Подтверждено'), ('completed', 'Завершено')],
        default='new', max_length=20
    )
    comment = models.TextField(blank=True, null=True)



from django import forms
from django.contrib.auth.forms import UserCreationForm
from django.contrib.auth.models import User
from django.core.validators import RegexValidator
from .models import Request


class UserWithPhoneCreationForm(UserCreationForm):
    # Добавляем поле телефона прямо в форму
    phone = forms.CharField(
        label="Номер телефона",
        max_length=17,
        validators=[RegexValidator(r"^\+?9\d{2} \d{3}-\d{2}-\d{2}$", "Формат: +999 999-99-99")]
    )

    class Meta(UserCreationForm.Meta):
        model = User
        fields = ("username",) # Поля, которые берем из базовой модели

    # Переопределяем сохранение, чтобы телефон ушел в базу
    def save(self, commit=True):
        user = super().save(commit=False)
        user.first_name = self.cleaned_data['phone'] # Пишем телефон в first_name
        if commit:
            user.save()
        return user


class RequestForm(forms.ModelForm):
    class Meta:
        model = Request
        fields = ('course', 'comment')



from django.urls import reverse_lazy
from django.views.generic import CreateView, ListView
from django.shortcuts import redirect
from .forms import UserWithPhoneCreationForm, RequestForm
from .models import Course, Request


class MyRegistrationView(CreateView):
    form_class = UserWithPhoneCreationForm
    template_name = "registration.html"
    success_url = reverse_lazy('login')


class CourseListView(ListView):
    model = Course
    template_name = "services.html"
    context_object_name = "page_obj"
    paginate_by = 3


class CabinetView(CreateView):
    model = Request
    form_class = RequestForm
    template_name = "cabinet.html"
    success_url = reverse_lazy('cabinet')

    def dispatch(self, request, *args, **kwargs):
        if not request.user.is_authenticated:
            return redirect('login')
        return super().dispatch(request, *args, **kwargs)

    def form_valid(self, form):
        form.instance.user = self.request.user
        return super().form_valid(form)

    def get_context_data(self, **kwargs):
        context = super().get_context_data(**kwargs)
        context['requests'] = Request.objects.filter(user=self.request.user)
        return context


